# Plantilla de entorno de Deliberia.
# Se copia automáticamente a .env en el primer arranque (docker compose up).
# .env está en .gitignore: NUNCA subas valores reales al repositorio.
# Los valores marcados "solo desarrollo" son locales y no sirven en producción.

APP_NAME=Deliberia
APP_ENV=local
# Se genera automáticamente en el primer arranque.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos (los hostnames son los servicios de compose.yaml).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=deliberia
DB_USERNAME=deliberia
# Solo desarrollo: contraseña del Postgres local de Docker (puerto solo en 127.0.0.1).
DB_PASSWORD=deliberia

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Redis local sin contraseña (puerto solo en 127.0.0.1).
REDIS_PASSWORD=null
REDIS_PORT=6379

# Los correos se escriben en el log; no se envía nada en desarrollo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Puertos publicados en 127.0.0.1 por docker compose (cámbialos si chocan con otros).
# Las claves APP_PORT, VITE_PORT, DB_FORWARD_PORT y REDIS_FORWARD_PORT las lee compose.yaml.
APP_PORT=8100
VITE_PORT=5180
DB_FORWARD_PORT=5440
REDIS_FORWARD_PORT=6390
